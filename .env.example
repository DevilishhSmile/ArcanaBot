# ══════════════════════════════════════════════════════
# ArcanaBot — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit your .env file to git!
# ══════════════════════════════════════════════════════

# ── DISCORD ──────────────────────────────────────────
# Get from: discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your_bot_token_here

# Your server ID (right-click server icon → Copy ID)
GUILD_ID=your_server_id_here

# ── GOOGLE SHEETS ─────────────────────────────────────
# The long ID in your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# ── CHANNELS ──────────────────────────────────────────
# Right-click any channel → Copy ID
CANAL_ENVIAR_UNIFORME=channel_id_here
CANAL_REGISTRAR_ESTUDIANTE=channel_id_here
CANAL_REGISTRO_TRABAJOS=channel_id_here
CANAL_CARTA_ACEPTACION=channel_id_here
CANAL_FICHAS_ESTUDIANTES=channel_id_here
CANAL_FICHAS_PROFESORES=channel_id_here
CANAL_FICHAS_TRABAJADORES=channel_id_here
CANAL_REVISION_UNIFORMES=channel_id_here
CANAL_REVISION_FICHAS=channel_id_here
CANAL_LOGS_BOT=channel_id_here
CANAL_SANCIONES=channel_id_here

# ── ROLES ─────────────────────────────────────────────
# Right-click any role → Copy ID
ROL_STAFF=role_id_here
ROL_ESTUDIANTE=role_id_here
ROL_PROFESOR=role_id_here
ROL_TRABAJADOR=role_id_here

# ── GENERATION ────────────────────────────────────────
# Current generation number (starts at 1)
# IMPORTANT: When you use /generacion cambiar, also update this value here!
GENERACION_ACTUAL=1
