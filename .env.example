# =============================================
# ISEFORA BOT — Variables de entorno
# =============================================
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a GitHub

# Token del bot (Discord Developer Portal)
DISCORD_TOKEN=

# ID del servidor de Discord (clic derecho al servidor → Copiar ID)
GUILD_ID=

# ID del Google Spreadsheet
# (está en la URL: docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit)
GOOGLE_SHEETS_ID=

# =============================================
# IDs de canales — Panel del servidor → Configuración → Canales → Clic derecho → Copiar ID
# =============================================

# Canales de registro (donde los usuarios envían sus fichas)
CANAL_ENVIAR_UNIFORME=
CANAL_REGISTRAR_ESTUDIANTE=
CANAL_REGISTRO_TRABAJOS=

# Canales de publicación (donde el bot publica las fichas aprobadas)
CANAL_CARTA_ACEPTACION=
CANAL_FICHAS_ESTUDIANTES=
CANAL_FICHAS_PROFESORES=
CANAL_FICHAS_TRABAJADORES=

# Canales de staff (solo staff puede verlos)
CANAL_REVISION_UNIFORMES=
CANAL_REVISION_FICHAS=
CANAL_LOGS_BOT=

# =============================================
# IDs de roles — Panel del servidor → Configuración → Roles → Clic derecho → Copiar ID
# =============================================

ROL_STAFF=
ROL_ESTUDIANTE=
ROL_PROFESOR=
ROL_TRABAJADOR=
ROL_SLOT_ADICIONAL=
